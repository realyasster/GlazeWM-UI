{
  "name": "glazewm-ui",
  "version": "1.0.0",
  "description": "Modern UI and Control Center for GlazeWM tiling window manager",
  "main": "dist-electron/main.js",
  "author": "Yasin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realyasster/GlazeWM-UI.git"
  },
  "bugs": {
    "url": "https://github.com/realyasster/GlazeWM-UI/issues"
  },
  "homepage": "https://github.com/realyasster/GlazeWM-UI#readme",
  "scripts": {
    "dev": "vite",
    "build:renderer": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && tsc -p tsconfig.electron.json -w\" \"wait-on dist-electron/main.js && electron .\"",
    "start": "electron .",
    "package": "npm run build && electron-builder --win",
    "package:portable": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "glazewm": "^1.7.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.glazewm.ui",
    "productName": "GlazeWM UI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
